# 统一编辑器行为；只放「不同人不同默认值会导致噪音」的项。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# 中英文之间常靠行尾两个空格断行，Markdown 里保留
trim_trailing_whitespace = false

[*.rs]
indent_size = 4

[*.{cmd,bat}]
# Windows 批处理必须是 CRLF，否则某些解析器会把行尾当命令的一部分
end_of_line = crlf

[*.{yml,yaml,json,jsonc,toml}]
indent_size = 2
