{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "仓库出入库明细",
  "version": "0.7.0",
  "identifier": "coldcoffee.warehouse.ledger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build && npm run build:remote",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "仓库出入库明细",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 700,
        "center": true,
        "theme": null,
        "backgroundColor": "#121212",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../dist-remote": "dist-remote"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese"]
      }
    }
  }
}
